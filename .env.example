# ============================================================
# Donate MinerDog — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: .env is gitignored. NEVER commit real values.
# ============================================================

# [REQUIRED] Your Solana wallet address (PUBLIC KEY only!)
# This is the address that will receive donations.
# Example: 7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU
VITE_MERCHANT_WALLET=

# [OPTIONAL] Solana network: "mainnet" or "devnet"
# Use "devnet" for testing, "mainnet" for production.
# Default: mainnet
VITE_SOLANA_NETWORK=devnet

# [OPTIONAL] Custom RPC endpoint URL
# Public RPC endpoints have rate limits. For production traffic,
# use a dedicated provider (Helius, QuickNode, Alchemy, etc.)
VITE_RPC_URL=
